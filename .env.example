# Copy to `.env` and adjust. docker-compose reads this file.
DJANGO_SECRET_KEY=dev-insecure-change-me
DEBUG=True

# USD -> CAD conversion (Scryfall provides no CAD price). Update occasionally.
FX_RATE_USD_CAD=1.38

# Scryfall requires a descriptive User-Agent. Put a contact in it.
SCRYFALL_USER_AGENT=MTGManager/1.0 (sebastianstanik52@gmail.com)

# --- NAS auto-deploy only — leave unset for local dev -----------------------
# AUTO_DEPLOY=true makes entrypoint.sh git-reset /app to origin/main and
# reinstall deps before every start, so stopping/starting the TrueNAS app
# redeploys the latest pushed commit. GIT_PAT is a GitHub fine-grained PAT
# (read-only, Contents scope, this repo only) used to authenticate the pull.
# AUTO_DEPLOY=true
# GIT_PAT=
